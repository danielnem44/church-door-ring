# Copy this file to .env.local for testing on your computer.
# On Vercel: Project → Settings → Environment Variables (same names).
# NEVER commit real keys to GitHub.

# ── Door team: who gets a phone call ──
# Name:number, separated by commas. Include the country code.
# Tip: you can add the church button phone too, e.g. "Dørtelefon:+4748391028"
DOOR_TEAM="Daniel:+4790000000, Anna:+4790000001"

# How alerts are sent: call (default) | whatsapp | both
NOTIFY_CHANNEL=call

# Also send a text message with a tap link (true/false). Costs a little per text.
NOTIFY_SMS=false

# Language the door team hears on the phone: en (default) or nb
TEAM_LANG=en

# ── Twilio (phone calls). Leave empty = TEST MODE (nothing is really called) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number the calls come from, with +, e.g. +15551234567
TWILIO_FROM=
# How many seconds each phone rings before giving up
CALL_RING_SECONDS=30

# ── Your site address. Twilio needs this to find the page that talks to the team ──
SITE_URL=

# ── Database (Upstash Redis). Needed on Vercel. Empty locally = memory. ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Stats page password: /api/stats?key=THIS ──
STATS_KEY=

# ── Anti-spam (optional) ──
RING_COOLDOWN_SECONDS=45
MAX_RINGS_PER_10_MIN=8

# ── Testing: ring even outside service hours. Turn OFF for real use. ──
FORCE_OPEN=false

# ── OPTIONAL: WhatsApp instead of / together with calls (needs Meta setup) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=door_ring
WHATSAPP_TEMPLATE_LANG=nb
WHATSAPP_API_VERSION=v23.0
